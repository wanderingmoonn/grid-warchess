    "rl:bench": "node --experimental-strip-types scripts/rl/bench-legal.ts",
    "rl:eval": "node --experimental-strip-types scripts/rl/eval.ts --mode policy --weights scripts/rl/weights/init.json",
    "rl:selfcheck": "node --experimental-strip-types scripts/rl/eval.ts --mode selfcheck",
