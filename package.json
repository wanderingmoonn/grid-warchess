    "test:serve": "node --experimental-strip-types scripts/smoke-serve.ts",
    "manual": "node --experimental-strip-types scripts/build-manual.ts",
    "snapshot": "node --experimental-strip-types scripts/snapshot-behavior.ts",
    "test:room": "node --experimental-strip-types scripts/smoke-room.ts",
    "sim": "node --experimental-strip-types scripts/sim-ai.ts",
    "sim:debug": "node --experimental-strip-types scripts/debug-ai.ts",
    "sim:naval": "node --experimental-strip-types scripts/naval-batch.ts",
    "sim:naval-merge": "node --experimental-strip-types scripts/naval-merge.ts",
    "map": "node --experimental-strip-types scripts/dump-map.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "perf": "node --experimental-strip-types --expose-gc scripts/perf.ts",
    "ablate": "node --experimental-strip-types scripts/ablate.ts",
    "ladder": "node --experimental-strip-types scripts/probe-ladder.ts",
    "probe:five": "node --experimental-strip-types scripts/probe-ai-five.ts",
    "probe:water": "node --experimental-strip-types scripts/probe-water.ts",
    "probe:quad": "node --experimental-strip-types scripts/probe-quad.ts",
