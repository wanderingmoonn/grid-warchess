    "adoption": "node --experimental-strip-types scripts/probe-adoption.ts",
    "duel": "node --experimental-strip-types scripts/ai-duel.ts",
    "balance": "node --experimental-strip-types scripts/balance-report.ts",
    "pack-report": "node --experimental-strip-types scripts/pack-report.ts",
    "fantasy": "node --experimental-strip-types scripts/dump-fantasy.ts",
