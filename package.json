    "ablate": "node --experimental-strip-types scripts/ablate.ts",
    "ladder": "node --experimental-strip-types scripts/probe-ladder.ts",
    "probe:five": "node --experimental-strip-types scripts/probe-ai-five.ts",
    "probe:water": "node --experimental-strip-types scripts/probe-water.ts",
    "probe:quad": "node --experimental-strip-types scripts/probe-quad.ts",
    "probe:composition": "node --experimental-strip-types scripts/probe-composition.ts",
