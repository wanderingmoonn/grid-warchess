# 依赖
node_modules/

# 构建产物（由 npm run build 生成，不进版本库）
dist/

# 规则书是 public/manual.html 的镜像副本，由 npm run manual 生成
/manual.html

# 环境变量
.env
.env.*
!.env.example

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# 临时文件
*.log
*.tmp

# 平衡实验的历史产物（results/packs 里的报告要进库，其余不进）
results/*
!results/packs/
# 反应射击评测（2026-11-11）：报告和原始 json 都要进库，方便复查
!results/reaction/

# 跑批脚本一次性导出的实验数据（results20/ results21/ …）
# 它们都能用 scripts/ 里的脚本按种子重跑出来，几百 KB 的 JSON 进库只是拖慢克隆
results[0-9]*/

# 奇幻兵种那条线的跑批产物（都能用 scripts/ 里的脚本重跑）
_build/
results-fantasy/
奇想兵种表*.xlsx

# 行为快照的对照文件（npm run snapshot 的输出，能用脚本重跑）
before.json
after.json

# 线上发布的静态产物：由 npm run build:static 生成，线上只发这几个文件
_publish/

# 复盘脚本的样本产物（npm run sample:reports 随时重造）
/reports-sample.json
/reports-sample.csv
/reports*.json
/reports*.csv

# 重放工具的临时产物
/rep*.json

# RL 训练用的 Python 环境（装 G 盘，不进仓库）
.venv/
__pycache__/

# vite 构建/加载配置时生成的临时文件
vite.config.ts.timestamp-*.mjs
