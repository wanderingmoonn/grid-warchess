# 依赖
node_modules/

# 构建产物（由 npm run build 生成，不进版本库）
dist/

# 规则书是 public/manual.html 的镜像副本，由 npm run manual 生成
/manual.html

# 环境变量
.env
.env.*
!.env.example

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# 临时文件
*.log
*.tmp

# 平衡实验的历史产物（results/packs 里的报告要进库，其余不进）
results/*
!results/packs/
